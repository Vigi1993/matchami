 scripts/db/dati-proprietario-dopo.sql         | 17 ++++++++++++++++
 scripts/db/dati-proprietario-prima.sql        | 13 ++++++++++++
 scripts/test-db-richieste.mjs                 | 15 ++++++++++++++
 scripts/test-profilo-proprietario.mjs         |  7 +++++++
 .../0036_togli_dati_proprietario.sql          | 20 +++++++++++++++++++
 5 files changed, 72 insertions(+)
 create mode 100644 scripts/db/dati-proprietario-dopo.sql
 create mode 100644 scripts/db/dati-proprietario-prima.sql
 create mode 100644 supabase/migrations/0036_togli_dati_proprietario.sql

diff --git a/scripts/db/dati-proprietario-dopo.sql b/scripts/db/dati-proprietario-dopo.sql
new file mode 100644
index 0000000..c44c8cb
--- /dev/null
+++ b/scripts/db/dati-proprietario-dopo.sql
@@ -0,0 +1,17 @@
+-- Dopo la 0036: le tre colonne e il tipo non ci sono più; il proprietario c'è ancora; i nuovi proprietari si creano come prima.
+\set ON_ERROR_STOP on
+\set QUIET on
+create function t.ok(c boolean, msg text) returns void language plpgsql as $$
+begin
+  if c is not true then raise exception 'CONTROLLO FALLITO: %', msg; end if;
+  raise notice 'OK: %', msg;
+end $$;
+select t.ok((select count(*) from information_schema.columns where table_name = 'owner_profiles' and column_name in ('proprietario_tipo', 'num_immobili', 'obiettivo')) = 0, 'D1 le tre colonne non ci sono più');
+select t.ok((select count(*) from pg_type where typname = 'tipo_proprietario') = 0, 'D2 e nemmeno il loro tipo');
+select t.ok((select array_agg(column_name::text order by column_name) from information_schema.columns where table_name = 'owner_profiles') = array['profile_id', 'updated_at'], 'D3 la tabella ha solo ciò che serve: l''identificativo e la data di aggiornamento');
+select t.ok((select count(*) from owner_profiles where profile_id = '55555555-0000-0000-0000-00000000000a') = 1, 'D4 il proprietario che aveva i dati c''è ancora (si perdono solo i tre valori)');
+insert into auth.users (id, email, raw_user_meta_data) values ('55555555-0000-0000-0000-00000000000c', 'c@x.it', '{"ruolo":"proprietario","nome":"Luisa","privacy_accettata":true}');
+select t.ok((select count(*) from owner_profiles where profile_id = '55555555-0000-0000-0000-00000000000c') = 1, 'D5 chi si iscrive come proprietario dopo la 0036 ottiene il suo profilo come prima');
+select t.ok((select count(*) from tenant_profiles where profile_id = '55555555-0000-0000-0000-00000000000b') = 1 and (select count(*) from owner_profiles where profile_id = '55555555-0000-0000-0000-00000000000b') = 0, 'D6 un inquilino non diventa proprietario');
+insert into listings (id, owner_id, titolo, zona, prezzo) values ('aaaaaaaa-0000-0000-0000-000000000099', '55555555-0000-0000-0000-00000000000a', 'Casa di prova', 'Milano', 900);
+select t.ok((select count(*) from listings where owner_id = '55555555-0000-0000-0000-00000000000a') = 1, 'D7 un proprietario può ancora avere i suoi immobili');
diff --git a/scripts/db/dati-proprietario-prima.sql b/scripts/db/dati-proprietario-prima.sql
new file mode 100644
index 0000000..117d622
--- /dev/null
+++ b/scripts/db/dati-proprietario-prima.sql
@@ -0,0 +1,13 @@
+-- Dati PRIMA della 0036 (database con le migrazioni fino alla 0035): un proprietario con i tre dati compilati.
+\set ON_ERROR_STOP on
+\set QUIET on
+create schema t;
+insert into auth.users (id, email, raw_user_meta_data) values
+ ('55555555-0000-0000-0000-00000000000a', 'a@x.it', '{"ruolo":"proprietario","nome":"Mario","privacy_accettata":true}'),
+ ('55555555-0000-0000-0000-00000000000b', 'b@x.it', '{"ruolo":"inquilino","nome":"Anna","privacy_accettata":true}');
+update owner_profiles set proprietario_tipo = 'agenzia', num_immobili = 5, obiettivo = 'Massima selezione inquilini' where profile_id = '55555555-0000-0000-0000-00000000000a';
+do $$ begin
+  if (select count(*) from information_schema.columns where table_name = 'owner_profiles' and column_name in ('proprietario_tipo', 'num_immobili', 'obiettivo')) <> 3 then raise exception 'PRIMA: le tre colonne dovevano esserci'; end if;
+  if (select proprietario_tipo::text from owner_profiles where profile_id = '55555555-0000-0000-0000-00000000000a') <> 'agenzia' then raise exception 'PRIMA: il tipo non si è salvato'; end if;
+  raise notice 'OK: prima della 0036 le tre colonne ci sono e hanno dei dati';
+end $$;
diff --git a/scripts/test-db-richieste.mjs b/scripts/test-db-richieste.mjs
index e285254..da751db 100644
--- a/scripts/test-db-richieste.mjs
+++ b/scripts/test-db-richieste.mjs
@@ -80,3 +80,18 @@ test("migrazione 0035 su PostgreSQL vero: l'affitto nasce dal contratto con la c
     const riusciti = (r.stderr.match(/NOTICE:\s+OK:/g) ?? []).length; assert.equal(riusciti, 61, `controlli riusciti: ${riusciti}`);
   } finally { fs.rmSync(nullo, { force: true }); esegui(["-d", "postgres", "-c", `drop database if exists ${db}`]); }
 });
+
+test("migrazione 0036 su PostgreSQL vero: si perdono solo i tre dati del proprietario e il loro tipo; il proprietario resta, i nuovi si creano come prima; rieseguirla non dà errori", { skip: psqlCmd ? false : "imposta MATCHAMI_PSQL per eseguire le prove SQL su un PostgreSQL vero" }, () => {
+  const [bin, ...args] = psqlCmd.split(/\s+/); const db = "matchami_test_dati_proprietario"; const esegui = (extra) => spawnSync(bin, [...args, "-X", "-q", ...extra], { encoding: "utf8" });
+  const migrazioni = fs.readdirSync(path.join(radice, "supabase", "migrations")).filter((f) => /^\d{4}_.*\.sql$/.test(f)).sort(); const m36 = migrazioni.find((f) => f.startsWith("0036_")); assert.ok(m36, "manca la migrazione 0036");
+  const nullo = path.join(os.tmpdir(), `matchami-dati-proprietario-${process.pid}.txt`);
+  try {
+    let r = esegui(["-d", "postgres", "-c", `drop database if exists ${db}`, "-c", `create database ${db}`]); assert.equal(r.status, 0, r.stderr);
+    r = esegui(["-d", db, "-v", "ON_ERROR_STOP=1", "-f", path.join(radice, "scripts", "db", "stub-supabase.sql")]); assert.equal(r.status, 0, r.stderr);
+    for (const m of migrazioni.filter((f) => f < "0036")) { r = esegui(["-d", db, "-v", "ON_ERROR_STOP=1", "-f", path.join(radice, "supabase", "migrations", m)]); assert.equal(r.status, 0, `${m}: ${r.stderr.slice(0, 300)}`); }
+    r = esegui(["-d", db, "-o", nullo, "-f", path.join(radice, "scripts", "db", "dati-proprietario-prima.sql")]); assert.equal(r.status, 0, "prima della 0036: " + r.stderr.slice(0, 300));
+    r = esegui(["-d", db, "-v", "ON_ERROR_STOP=1", "-f", path.join(radice, "supabase", "migrations", m36)]); assert.equal(r.status, 0, "la 0036 non si applica: " + r.stderr.slice(0, 300));
+    r = esegui(["-d", db, "-o", nullo, "-f", path.join(radice, "scripts", "db", "dati-proprietario-dopo.sql")]); assert.ok(!/CONTROLLO FALLITO/.test(r.stderr), r.stderr.split("\n").filter((l) => /FALLITO/.test(l)).join("\n")); assert.equal(r.status, 0, r.stderr.slice(0, 300)); assert.equal((r.stderr.match(/NOTICE:\s+OK:/g) ?? []).length, 7);
+    r = esegui(["-d", db, "-v", "ON_ERROR_STOP=1", "-f", path.join(radice, "supabase", "migrations", m36)]); assert.equal(r.status, 0, "rieseguire la 0036 non deve dare errori: " + r.stderr.slice(0, 300));
+  } finally { fs.rmSync(nullo, { force: true }); esegui(["-d", "postgres", "-c", `drop database if exists ${db}`]); }
+});
diff --git a/scripts/test-profilo-proprietario.mjs b/scripts/test-profilo-proprietario.mjs
index 262142a..5df27a7 100644
