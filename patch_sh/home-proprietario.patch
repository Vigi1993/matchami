+   ============================================================ */
+.casa-saluto {
+  margin: 0 0 2px;
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--body-soft);
+}
+.casa-invito {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 14px;
+  min-height: 68px;
+  margin: 6px 0 20px;
+  padding: 12px 14px 12px 20px;
+  border-radius: 22px;
+  background: var(--gold);
+  color: var(--ink);
+  font-size: 19px;
+  font-weight: 700;
+  line-height: 1.25;
+  text-decoration: none;
+  box-shadow: 0 10px 24px rgba(201, 161, 90, 0.35);
+  -webkit-tap-highlight-color: transparent;
+}
+.casa-invito b {
