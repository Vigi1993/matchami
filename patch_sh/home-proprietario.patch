+  padding: 11px 18px;
+  border-radius: 999px;
+  background: var(--ink);
+  color: var(--paper);
+  font-size: 18px;
+}
+.casa-invito:focus-visible,
+.casa-attesa:focus-visible,
+.casa-hero:focus-visible {
+  outline: 3px solid var(--moss);
+  outline-offset: 3px;
+}
+.casa {
+  margin-bottom: 28px;
+}
+.casa-hero {
+  position: relative;
+  display: block;
+  height: 300px;
+  overflow: hidden;
+  border-radius: 28px;
+  background: var(--ink-soft);
+  color: #fff;
+  text-decoration: none;
+  box-shadow: 0 18px 40px rgba(16, 21, 26, 0.22);
+  -webkit-tap-highlight-color: transparent;
+}
+.casa.compatta .casa-hero {
+  height: 210px;
+}
+.casa-foto {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+.casa-foto-vuota {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: linear-gradient(135deg, var(--moss) 0%, var(--moss-light) 55%, var(--gold) 150%);
+}
+.casa-icona-vuota {
+  width: 96px;
+  height: 96px;
+  fill: none;
+  stroke: rgba(255, 255, 255, 0.6);
