+  assert.match(v.validaNuovoPosto(tra(2 * GIORNO + 29 * MIN), ADESSO, [base], 0), /servono almeno 30 minuti/);
+  assert.match(v.validaNuovoPosto(tra(2 * GIORNO - 29 * MIN), ADESSO, [base], 0), /servono almeno 30 minuti/);
+  assert.equal(v.validaNuovoPosto(tra(2 * GIORNO + 30 * MIN), ADESSO, [base], 0), null);
