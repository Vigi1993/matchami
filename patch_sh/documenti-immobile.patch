+  const d = vf.documentiProprieta(righe, "a1"); assert.deepEqual(d.map((x) => x.id), ["2", "5", "1", "6"], "dalla più recente; senza data in fondo"); assert.deepEqual(d.map((x) => x.nome), ["nuova.pdf", "Documento", "vecchia.pdf", "Documento"]);
