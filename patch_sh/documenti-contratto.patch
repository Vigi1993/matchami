     .split(/\s+/)[0];
   if (!primo) return null;
diff --git a/src/lib/mappe/indirizzo.ts b/src/lib/mappe/indirizzo.ts
index 3c21572..3e5d303 100644
--- a/src/lib/mappe/indirizzo.ts
+++ b/src/lib/mappe/indirizzo.ts
@@ -19,7 +19,7 @@ export const CITTA_PREDEFINITA = "Milano";
 /** Spazi ridotti a uno, ai lati niente, e nessun carattere di controllo (a capo, tabulazioni, invisibili). */
