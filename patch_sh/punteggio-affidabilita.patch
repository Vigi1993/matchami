+      </p>
+      <form action={formAction}>
+        <input type="hidden" name="professione" value={professione} />
+        <input type="hidden" name="reddito_mensile" value={reddito} />
+        <input type="hidden" name="reddito_nucleo" value={redditoNucleo} />
