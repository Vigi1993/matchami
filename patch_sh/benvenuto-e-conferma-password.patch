diff --git a/src/app/benvenuto/BenvenutoClient.tsx b/src/app/benvenuto/BenvenutoClient.tsx
new file mode 100644
index 0000000..f8cc464
--- /dev/null
+++ b/src/app/benvenuto/BenvenutoClient.tsx
@@ -0,0 +1,220 @@
+"use client";
+
+import { useActionState, useState } from "react";
+import { useRouter } from "next/navigation";
+import { logout } from "@/app/login/actions";
+import { completaBenvenuto, type BenvenutoState } from "./actions";
+import { creaImmobile } from "@/app/(app)/immobili/actions";
+import { ImmobileForm } from "@/app/(app)/immobili/ImmobiliClient";
+import { DatiForm, type SezioneDati } from "@/components/DatiForm";
+import { RicercaSheet } from "@/components/RicercaSheet";
+import { CaricaIdentita } from "@/components/CaricaIdentita";
+import { VerificaImmobile } from "@/components/VerificaImmobile";
+import {
+  TESTI_BENVENUTO,
+  indirizzoPasso,
+  percentualeProgresso,
+  puoAndareAvanti,
+  puoFinire,
+  testoProgresso,
+  type Passo,
+} from "@/lib/benvenuto";
+import type { TenantProfile } from "@/lib/types";
+import type { ProfiloRicerca } from "@/lib/match";
+import type { Luogo } from "@/lib/luoghi";
+import type { ImmobileVerifica } from "@/lib/verifica";
+import type { RisultatoQuotazione } from "@/lib/prezzi";
+
+type Comune = {
+  nome: string | null;
+  /** tutte le schede del ruolo, con lo stato di oggi (calcolato sul server dai dati salvati) */
+  passi: Passo[];
+  /** la scheda che si vede (da 0) */
+  indice: number;
+};
+
+export type BenvenutoProps =
+  | (Comune & {
+      ruolo: "inquilino";
+      tenant: TenantProfile;
+      ricerca: ProfiloRicerca;
+      luoghi: Luogo[];
+      verificaPanel: React.ReactNode;
+      protestiPanel: React.ReactNode;
+    })
+  | (Comune & {
+      ruolo: "proprietario";
+      haIdentita: boolean;
+      nomiIdentita: string[];
+      immobile: ImmobileVerifica | null;
+      quotazioni: Record<string, RisultatoQuotazione>;
+      luoghi: Luogo[];
+    });
+
+const SEZIONE_DATI: Record<string, SezioneDati> = { persona: "persona", reddito: "reddito", garanzie: "garanzie" };
+
+/**
+ * Il percorso di benvenuto: una scheda alla volta, con la barra dei passi. Riusa i moduli che già esistono (dati, ricerca, nuovo immobile, documenti),
+ * così non ci sono due versioni da tenere allineate. Le schede obbligatorie non si superano senza aver salvato i dati; le altre si possono saltare.
+ */
+export function BenvenutoClient(p: BenvenutoProps) {
+  const router = useRouter();
+  const { passi, indice } = p;
+  const passo = passi[indice];
+  const ultimo = indice === passi.length - 1;
+  const [stato, azioneFine, inCorso] = useActionState<BenvenutoState>(completaBenvenuto, null);
+
+  const vai = (i: number) => router.push(indirizzoPasso(i));
+  const avanti = () => vai(indice + 1);
+
+  return (
+    <div className="benvenuto">
+      <header className="benvenuto-testa">
+        <div className="benvenuto-marchio">
+          Match<b>AmI</b>
+        </div>
+        <p className="benvenuto-saluto">{TESTI_BENVENUTO.saluto(p.nome)}</p>
+        <p className="benvenuto-intro">{p.ruolo === "inquilino" ? TESTI_BENVENUTO.introInquilino : TESTI_BENVENUTO.introProprietario}</p>
+      </header>
+
+      <div className="benvenuto-progresso">
+        <div
+          className="benvenuto-barra"
+          role="progressbar"
+          aria-valuemin={1}
+          aria-valuemax={passi.length}
+          aria-valuenow={indice + 1}
+          aria-label={testoProgresso(indice, passi.length)}
+        >
+          <i style={{ width: `${percentualeProgresso(indice, passi.length)}%` }} />
+        </div>
+        <div className="benvenuto-passi">
+          <span className="benvenuto-conteggio">{testoProgresso(indice, passi.length)}</span>
+          <ol className="benvenuto-puntini" aria-label="Le schede">
+            {passi.map((s, i) => (
+              <li key={s.id} className={`${i === indice ? "attivo" : ""} ${s.completo ? "fatto" : ""}`.trim()} aria-current={i === indice ? "step" : undefined}>
+                <span className="solo-lettori">{s.titolo}</span>
+              </li>
+            ))}
+          </ol>
+        </div>
+      </div>
+
+      <section className="benvenuto-scheda" aria-labelledby="benvenuto-titolo">
+        <h1 id="benvenuto-titolo" className="benvenuto-titolo">
+          {passo.titolo}
+        </h1>
+        <p className="benvenuto-descrizione">{passo.descrizione}</p>
+        <p className={`benvenuto-tipo ${passo.obbligatorio ? "obbligatoria" : ""}`.trim()}>
+          {passo.obbligatorio ? TESTI_BENVENUTO.obbligatorio : TESTI_BENVENUTO.facoltativo}
+        </p>
+
+        <div className="benvenuto-contenuto">
+          {p.ruolo === "inquilino" ? <ContenutoInquilino p={p} passo={passo} avanti={avanti} /> : <ContenutoProprietario p={p} passo={passo} router={router} />}
+        </div>
+      </section>
+
+      <nav className="benvenuto-azioni" aria-label="Navigazione tra le schede">
+        {indice > 0 && (
+          <button type="button" className="richieste-secondario" onClick={() => vai(indice - 1)}>
+            {TESTI_BENVENUTO.indietro}
+          </button>
+        )}
+        {!ultimo ? (
+          <button type="button" className="opp-cta" disabled={!puoAndareAvanti(passo)} onClick={avanti}>
+            {passo.completo || passo.obbligatorio ? TESTI_BENVENUTO.avanti : TESTI_BENVENUTO.saltaPerOra}
+          </button>
+        ) : (
+          <form action={azioneFine}>
+            <button type="submit" className="opp-cta" disabled={!puoFinire(passi) || inCorso}>
+              {inCorso ? "Un momento..." : TESTI_BENVENUTO.finisci}
+            </button>
+          </form>
+        )}
+      </nav>
+      {stato?.error && (
+        <p className="note-error" role="alert">
+          {stato.error}
+        </p>
+      )}
+
+      <form action={logout} className="benvenuto-esci">
+        <button type="submit" className="redo-link">
+          Esci
+        </button>
+      </form>
+    </div>
+  );
+}
+
+function ContenutoInquilino({ p, passo, avanti }: { p: Extract<BenvenutoProps, { ruolo: "inquilino" }>; passo: Passo; avanti: () => void }) {
+  const router = useRouter();
+  const [ricercaAperta, setRicercaAperta] = useState(false);
+
+  if (passo.id === "persona" || passo.id === "reddito" || passo.id === "garanzie") {
+    // una scheda del modulo dei dati: salvando si passa alla successiva
+    return <DatiForm key={passo.id} tenant={p.tenant} sezione={SEZIONE_DATI[passo.id]} etichettaSalva="Salva e continua" onSalvata={avanti} />;
+  }
+
+  if (passo.id === "ricerca") {
+    return (
+      <>
+        {passo.completo ? (
+          <p className="benvenuto-fatto" role="status">
+            Ricerca impostata: fino a €{p.tenant.budget_max?.toLocaleString("it-IT")} al mese.
+          </p>
+        ) : (
+          <p className="field-note">Indica almeno il budget massimo: è ciò che ti fa vedere le case giuste.</p>
+        )}
+        <button type="button" className="opp-cta" onClick={() => setRicercaAperta(true)}>
+          {passo.completo ? "Modifica la ricerca" : "Imposta la ricerca"}
+        </button>
+        <RicercaSheet
+          open={ricercaAperta}
+          onClose={() => setRicercaAperta(false)}
+          ricerca={p.ricerca}
+          luoghi={p.luoghi}
+          onSalvata={() => {
+            setRicercaAperta(false);
+            router.refresh();
+          }}
+        />
+      </>
+    );
+  }
+
+  // documenti: identità, prova del reddito, certificato dei protesti (si possono caricare anche dopo)
+  return (
+    <>
+      <div className="benvenuto-sezione">
+        <h2 className="benvenuto-sottotitolo">Reddito</h2>
+        {p.verificaPanel}
+      </div>
+      <div className="benvenuto-sezione">
+        <h2 className="benvenuto-sottotitolo">Protesti</h2>
+        {p.protestiPanel}
+      </div>
+    </>
+  );
+}
+
+function ContenutoProprietario({ p, passo, router }: { p: Extract<BenvenutoProps, { ruolo: "proprietario" }>; passo: Passo; router: ReturnType<typeof useRouter> }) {
+  if (passo.id === "identita") {
+    return <CaricaIdentita nomiCaricati={p.nomiIdentita} />;
+  }
+
+  if (passo.id === "casa") {
+    if (p.immobile) {
+      return (
+        <p className="benvenuto-fatto" role="status">
+          Hai già aggiunto: <b>{p.immobile.titolo}</b>. Potrai modificarla e aggiungere altre case dalla sezione «Immobili».
+        </p>
+      );
+    }
+    return <ImmobileForm action={creaImmobile} quotazioni={p.quotazioni} luoghi={p.luoghi} etichettaSalva="Salva e continua" onSaved={() => router.refresh()} />;
+  }
+
+  // prova di proprietà del suo primo immobile
+  if (!p.immobile) return <p className="field-note">Prima aggiungi la tua casa.</p>;
+  return <VerificaImmobile key={p.immobile.id} immobile={p.immobile} haIdentita={p.haIdentita} conIdentita />;
+}
diff --git a/src/app/benvenuto/actions.ts b/src/app/benvenuto/actions.ts
new file mode 100644
index 0000000..be070a5
--- /dev/null
+++ b/src/app/benvenuto/actions.ts
@@ -0,0 +1,26 @@
+"use server";
+
+import { revalidatePath } from "next/cache";
+import { redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
+import { messaggioErroreBenvenuto } from "@/lib/benvenuto";
+
+export type BenvenutoState = { error?: string } | null;
+
+/**
+ * Chiude il percorso di benvenuto e porta nell'app. Cosa serve per completare (i dati essenziali del ruolo) lo controlla il database
+ * (funzione completa_onboarding): qui si chiama e, se manca qualcosa, si dice cosa in italiano.
+ */
+export async function completaBenvenuto(): Promise<BenvenutoState> {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) return { error: messaggioErroreBenvenuto("NON_AUTENTICATO") };
+
+  const { error } = await supabase.rpc("completa_onboarding");
+  if (error) return { error: messaggioErroreBenvenuto(error.message) };
+
+  revalidatePath("/", "layout");
+  redirect("/");
+}
diff --git a/src/app/benvenuto/page.tsx b/src/app/benvenuto/page.tsx
new file mode 100644
index 0000000..fa08a03
--- /dev/null
+++ b/src/app/benvenuto/page.tsx
@@ -0,0 +1,110 @@
+import { redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
+import { INFORMATIVA } from "@/content/informativa";
+import { haAccettatoInformativa, versioniAccettabili } from "@/lib/informativa";
+import { passiInquilino, passiProprietario, passoDaMostrare } from "@/lib/benvenuto";
+import { profiloRicercaDaRighe } from "@/lib/match";
+import { documentiProprieta, immobileVerificaDa } from "@/lib/verifica";
+import { quotazioniPerZone } from "@/lib/prezzi";
+import { ZONE_MILANO } from "@/lib/constants";
+import type { Luogo } from "@/lib/luoghi";
+import type { TenantProfile } from "@/lib/types";
+import type { DocumentoInquilino } from "@/lib/verifica-inquilino";
+import { VerificaRedditoPanel } from "@/components/VerificaRedditoPanel";
+import { VerificaProtestiPanel } from "@/components/VerificaProtestiPanel";
+import { BenvenutoClient } from "./BenvenutoClient";
+
+/**
+ * Il percorso di benvenuto: dopo l'iscrizione (e l'accettazione dell'informativa) si compilano i dati che servono, una scheda alla volta.
+ * Chi l'ha già completato torna nell'app. Le schede sono diverse per l'inquilino e per il proprietario.
+ */
+export default async function BenvenutoPage({ searchParams }: { searchParams: Promise<{ passo?: string }> }) {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+
+  if (!(await haAccettatoInformativa(supabase, user.id, versioniAccettabili(INFORMATIVA)))) redirect("/informativa/accetta");
+
+  // Se non si legge il profilo (o il benvenuto è già fatto) si va nell'app: meglio entrare che restare bloccati.
+  const { data: profilo } = await supabase.from("profiles").select("ruolo, nome, onboarding_completato").eq("id", user.id).single();
+  if (!profilo || profilo.onboarding_completato !== false) redirect("/");
+
+  const { passo: richiesto } = await searchParams;
+  const { data: luoghiRighe } = await supabase.from("luoghi").select("id, livello, nome, sigla, parent_id");
+  const luoghi = (luoghiRighe ?? []) as Luogo[];
+
+  if (profilo.ruolo === "proprietario") {
+    const [{ data: case_ }, { data: documenti }] = await Promise.all([
+      supabase
+        .from("listings")
+        .select("id, titolo, zona, verifica_stato, verifica_esito_note, classe_energetica, luogo_id, bagni, piano, riscaldamento, tipo_contratto, disponibile_dal")
+        .eq("owner_id", user.id)
+        .order("created_at", { ascending: true }),
+      supabase.from("documenti_verifica").select("id, tipo, listing_id, nome_file, percorso, created_at").eq("owner_id", user.id),
+    ]);
+    const prima = (case_ ?? [])[0] ?? null;
+    const proprieta = prima ? documentiProprieta(documenti, prima.id as string) : [];
+    const identita = (documenti ?? []).filter((d) => d.tipo === "identita");
+    const passi = passiProprietario({ nImmobili: (case_ ?? []).length, haIdentita: identita.length > 0, haProva: proprieta.length > 0 });
+    const quotazioni = await quotazioniPerZone(ZONE_MILANO);
+    return (
+      <BenvenutoClient
+        ruolo="proprietario"
+        nome={profilo.nome ?? null}
+        passi={passi}
+        indice={passoDaMostrare(passi, richiesto)}
+        haIdentita={identita.length > 0}
+        nomiIdentita={identita.map((d) => (d.nome_file as string | null) ?? "Documento")}
+        immobile={prima ? immobileVerificaDa({ ...(prima as Parameters<typeof immobileVerificaDa>[0]), documenti: proprieta }) : null}
+        quotazioni={quotazioni}
+        luoghi={luoghi}
+      />
+    );
+  }
+
+  const [{ data: tenant }, { data: zoneRows }, { data: interessiRows }, { data: documentiRows }] = await Promise.all([
+    supabase.from("tenant_profiles").select("*").eq("profile_id", user.id).single(),
+    supabase.from("tenant_zone_interesse").select("zona, luogo_id").eq("tenant_id", user.id),
+    supabase.from("tenant_interessi").select("attributo_key, peso, valore, necessaria").eq("tenant_id", user.id),
+    supabase.from("documenti_inquilino").select("id, tipo, percorso, nome_file").eq("tenant_id", user.id).order("created_at", { ascending: true }),
+  ]);
+  const t = tenant as TenantProfile;
+  const documenti = (documentiRows ?? []) as DocumentoInquilino[];
+  const passi = passiInquilino({
+    professione: t.professione,
+    redditoMensile: t.reddito_mensile,
+    protestato: t.protestato,
+    budgetMax: t.budget_max,
+    documenti: documenti.map((d) => d.tipo),
+  });
+
+  return (
+    <BenvenutoClient
+      ruolo="inquilino"
+      nome={profilo.nome ?? null}
+      passi={passi}
+      indice={passoDaMostrare(passi, richiesto)}
+      tenant={t}
+      ricerca={profiloRicercaDaRighe(t, zoneRows, interessiRows)}
+      luoghi={luoghi}
+      verificaPanel={
+        <VerificaRedditoPanel
+          stato={t.verifica_stato}
+          nota={t.verifica_esito_note}
+          dati={{ professione: t.professione, reddito_mensile: t.reddito_mensile }}
+          documenti={documenti}
+        />
+      }
+      protestiPanel={
+        <VerificaProtestiPanel
+          stato={t.protesti_verifica_stato ?? "non_avviata"}
+          nota={t.protesti_verifica_esito_note ?? null}
+          protestato={t.protestato}
+          documenti={documenti}
+        />
+      }
+    />
+  );
+}
