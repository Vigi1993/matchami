+export * from "./config";
+export * from "./tipi";
+export { etichettaPer } from "./comuni";
+export { calcolaMatchInquilino, ordinaAnnunci } from "./inquilino";
+export {
+  CATALOGO_CRITERI,
+  CHIAVI_CRITERI,
+  calcolaMatchProprietario,
+  confrontaCandidati,
+  ordinaCandidati,
+} from "./proprietario";
+export type { VoceCandidato } from "./proprietario";
