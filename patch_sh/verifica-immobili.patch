+  const cartella = path.join(radice, "src");
+  const trovati = [];
+  const visita = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) {
+    const p = path.join(d, e.name);
+    if (e.isDirectory()) visita(p);
