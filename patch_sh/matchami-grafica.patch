+}
+
+/* area schermate: tutto lo spazio sopra la tab bar */
+.screens {
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  bottom: var(--tabbar-h);
+  overflow: hidden;
+}
+
+/* wrapper standard di una schermata su fondo chiaro */
+.screen-wrap {
+  position: absolute;
+  inset: 0;
+  background: var(--paper);
+  overflow-y: auto;
+  -webkit-overflow-scrolling: touch;
+  padding: 24px 20px 30px 20px;
+}
+
+/* schermata a tutto schermo su fondo scuro (deck) */
+.screen-dark {
+  position: absolute;
+  inset: 0;
+  background: var(--ink);
+}
+
+/* ============ elementi condivisi ============ */
+.topbar {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  z-index: 40;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 18px 18px 0 18px;
+  pointer-events: none;
+}
+.brand {
+  font-family: var(--font-display);
+  font-style: italic;
+  font-weight: 700;
+  font-size: 22px;
+  letter-spacing: 0.3px;
+  color: var(--paper);
+  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
+}
+.brand b {
+  color: var(--gold);
+  font-style: normal;
+}
+.counter {
