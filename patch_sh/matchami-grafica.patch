+}
+
+/* ============ guscio dell'app (il "#app" del prototipo) ============ */
+.app-shell {
+  position: relative;
+  width: 100%;
+  max-width: 480px;
+  height: 100vh;
+  height: 100dvh;
+  margin: 0 auto;
+  background: var(--ink);
+  overflow: hidden;
