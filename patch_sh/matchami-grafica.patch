+  border: 3px solid var(--paper);
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
+}
+
+.ob-textarea {
+  width: 100%;
+  border: 1.5px solid rgba(16, 21, 26, 0.12);
+  border-radius: 14px;
+  background: #fff;
+  padding: 13px 14px;
