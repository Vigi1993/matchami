+  criteri: CriterioRichiesto[]
+): Promise<string | null> {
+  if (criteri.length > 0) {
+    const { error } = await supabase
+      .from("listing_criteri")
+      .upsert(righeDaCriteri(listingId, criteri), {
+        onConflict: "listing_id,chiave",
